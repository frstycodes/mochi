{
  "extends": "../../tsconfig.base.json",
  // Not a composite project: the agents import the app's shared modules (`src/`, `electron/`), outside any one rootDir.
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "emitDeclarationOnly": false,
    "noEmit": true,
    "lib": ["ES2023", "DOM"],
    "resolveJsonModule": true,
    // The thread tools run the window's own modules (`runtime/tools.ts`), which import through `@/` and reach the `.tsx` store.
    "jsx": "react-jsx",
    "paths": { "@/*": ["../../apps/desktop/src/*"] }
  },
  "include": ["src"]
}
