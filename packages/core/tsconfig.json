{
  "extends": "../../tsconfig.base.json",
  // Not a composite project: the agents import the app's shared modules (`src/`, `electron/`), outside any one rootDir.
  "compilerOptions": { "composite": false, "declaration": false, "emitDeclarationOnly": false, "noEmit": true, "lib": ["ES2023", "DOM"], "resolveJsonModule": true },
  "include": ["src"]
}
