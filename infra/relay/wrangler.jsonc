{
  // Deployed to the account owner's own Cloudflare account; self-hosters deploy this same Worker to theirs.
  "name": "mochi-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": { "bindings": [{ "name": "ACCOUNTS", "class_name": "AccountRelay" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AccountRelay"] }],
  // Clerk development instance. TODO(owner: Sandesh): a `routes` entry for the relay's domain, and the production issuer at launch.
  "vars": { "CLERK_ISSUER": "https://amazed-hyena-4980.clerk.accounts.dev", "CLERK_CLIENT_ID": "DrmXYYxWDX3SDT5B" }
}
