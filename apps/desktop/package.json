{
  "name": "harness-proto",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vp dev",
    "artifact": "vp run build --mode artifact && node scripts/artifact.mjs",
    "electron:dev": "vp dev --mode electron",
    "electron:build": "tsc -b && tsc -p electron && pnpm electron:pack",
    "electron:pack": "vp build --mode electron && node scripts/build-native.mjs && electron-builder --dir",
    "typecheck": "tsc -b && tsc -p electron"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.308",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@dnd-kit/dom": "0.5.1",
    "@dnd-kit/react": "0.5.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@mochi/core": "workspace:*",
    "@mochi/domain": "workspace:*",
    "@mochi/schema": "workspace:*",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/core": "2.4.0",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@modelcontextprotocol/server": "2.4.0",
    "@parcel/watcher": "2.6.0",
    "@pierre/diffs": "^1.6.1",
    "@radix-ui/react-use-controllable-state": "^1.2.6",
    "@react-symbols/icons": "^1.4.1",
    "@shadcn/react": "^0.3.1",
    "@solar-icons/react": "^2.3.2",
    "@streamdown/cjk": "^1.0.4",
    "@streamdown/code": "^2.0.0",
    "@streamdown/math": "^1.0.3",
    "@streamdown/mermaid": "^1.0.3",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/react-virtual": "^3.14.18",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "ai": "^7.0.137",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "codemirror": "^6.0.2",
    "date-fns": "^4.4.0",
    "effect": "4.0.5",
    "embla-carousel-react": "^8.6.0",
    "html-to-image": "1.11.13",
    "input-otp": "^1.5.0",
    "katex": "0.19.0",
    "libsodium-wrappers": "0.8.4",
    "motion": "^14.1.0",
    "next-themes": "^0.4.6",
    "node-pty": "^1.1.0",
    "playwright-core": "1.64.1",
    "radix-ui": "^1.7.0",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-error-boundary": "^6.1.6",
    "react-resizable-panels": "^4.14.4",
    "recharts": "3.10.1",
    "shadcn": "^4.21.4",
    "shiki": "^4.5.0",
    "streamdown": "^2.7.0",
    "tinykeys": "^4.0.1",
    "tokenlens": "^1.3.1",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.6",
    "use-sync-external-store": "^1.7.0",
    "uuid": "^14.0.3",
    "vaul": "^1.1.2",
    "ws": "^8.22.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@playwright/test": "1.64.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/use-sync-external-store": "^0.0.6",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "electron": "44.7.0",
    "electron-builder": "26.18.0",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@tsc-rs/typescript@0.8.0",
    "vite": "catalog:",
    "vite-plugin-electron": "1.1.2",
    "vite-plugin-singlefile": "^2.3.3",
    "vite-plus": "catalog:"
  },
  "build": {
    "appId": "dev.mochi.app",
    "productName": "Mochi",
    "files": [
      "dist/**",
      "dist-electron/**",
      "!node_modules/**",
      "node_modules/node-pty/package.json",
      "node_modules/node-pty/lib/**/*.js",
      "node_modules/node-pty/prebuilds/${platform}-${arch}/**",
      "node_modules/playwright-core/**",
      "node_modules/@parcel/watcher-*/**"
    ],
    "afterPack": "scripts/after-pack.mjs",
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true,
      "enableEmbeddedAsarIntegrityValidation": true,
      "enableCookieEncryption": true,
      "resetAdHocDarwinSignature": true
    },
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/node-pty/prebuilds/**",
      "node_modules/@parcel/watcher-*/**"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": "dir",
      "icon": "build/icon.icns",
      "identity": null,
      "extraResources": [
        {
          "from": "build/native/haptic",
          "to": "haptic"
        },
        {
          "from": "build/native/windows",
          "to": "windows"
        },
        {
          "from": "build/icons",
          "to": "icons",
          "filter": [
            "*.png"
          ]
        },
        {
          "from": "build/native/uv",
          "to": "uv"
        }
      ]
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "extraResources": [
        {
          "from": "build/icons",
          "to": "icons",
          "filter": [
            "*.png"
          ]
        }
      ]
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png",
      "category": "Development",
      "extraResources": [
        {
          "from": "build/icons",
          "to": "icons",
          "filter": [
            "*.png"
          ]
        },
        {
          "from": "build/native/uv",
          "to": "uv"
        }
      ]
    }
  }
}
