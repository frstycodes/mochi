{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "ignoreDependencies": ["@effect/language-service", "cloudflare"],
  "ignoreBinaries": ["mkfifo", "lipo"],
  "rules": {
    "exports": "off",
    "types": "off",
    "enumMembers": "off",
    "duplicates": "off"
  },
  "workspaces": {
    "apps/desktop": {
      "entry": [
        "electron/main.ts",
        "electron/preload.ts",
        "scripts/*.{ts,mjs}",
        "tests/e2e/*.{ts,js,mjs}",
        "src/lib/{shiki-slim,no-wasm}.ts"
      ],
      "ignore": [
        "src/schemaConformance/**",
        "src/schedule/RunMenu.tsx",
        "src/goals/outcome.ts",
        "src/settings/sections/goals.tsx"
      ],
      "ignoreDependencies": ["@parcel/watcher", "node-pty"]
    },
    "packages/schema": {
      "ignore": ["scripts/**"],
      "ignoreDependencies": ["@anthropic-ai/claude-agent-sdk"]
    }
  }
}
