{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "composite": true,
    "emitDeclarationOnly": true,
    "declaration": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "plugins": [
      {
        "name": "@effect/language-service",
        "includeSuggestionsInTsc": false,
        "diagnosticSeverity": { "unstableApiUsage": "off", "schemaNumber": "off" }
      }
    ]
  }
}
