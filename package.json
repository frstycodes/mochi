{
  "name": "mochi-workspace",
  "version": "0.0.0",
  "private": true,
  "bin": {
    "mochi": "bin/mochi.mjs"
  },
  "type": "module",
  "scripts": {
    "prepare": "vp config",
    "dev": "pnpm -F harness-proto dev",
    "artifact": "pnpm -F harness-proto artifact",
    "electron:dev": "pnpm -F harness-proto electron:dev",
    "electron:build": "pnpm -F harness-proto electron:build",
    "electron:pack": "pnpm -F harness-proto electron:pack",
    "typecheck": "vp run tsc"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.5",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "5.0.3",
    "effect": "4.0.5",
    "eslint-plugin-sonarjs": "^4.2.2",
    "knip": "^6.43.0",
    "typescript": "npm:@tsc-rs/typescript@0.8.0",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@10.24.0"
}
