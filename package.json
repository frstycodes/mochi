{
  "name": "harness-proto",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "dev": "vp dev",
    "build": "tsc -b && vp build",
    "typecheck": "tsc -b && tsc -p electron",
    "test": "node --test \"src/**/*.test.ts\" \"electron/**/*.test.ts\"",
    "artifact": "pnpm build && node scripts/artifact.mjs",
    "electron:dev": "vp dev --mode electron",
    "electron:build": "tsc -b && tsc -p electron && vp build --mode electron && node scripts/build-native.mjs && electron-builder --dir"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.296",
    "@base-ui/react": "^1.9.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@fontsource-variable/inter": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@pierre/diffs": "^1.5.2",
    "@radix-ui/react-use-controllable-state": "^1.2.6",
    "@react-symbols/icons": "^1.4.1",
    "@shadcn/react": "^0.3.1",
    "@streamdown/cjk": "^1.0.4",
    "@streamdown/code": "^2.0.0",
    "@streamdown/math": "^1.0.3",
    "@streamdown/mermaid": "^1.0.3",
    "@tanstack/react-virtual": "^3.14.18",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "ai": "^7.0.137",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "codemirror": "^6.0.2",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "katex": "0.16.47",
    "motion": "^14.1.0",
    "nanoid": "^6.0.2",
    "next-themes": "^0.4.6",
    "node-pty": "^1.1.0",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.0",
    "react-resizable-panels": "^4.14.4",
    "recharts": "3.8.0",
    "reicon-react": "^1.2.6",
    "shadcn": "^4.21.4",
    "shiki": "^4.5.0",
    "simple-icons": "^16.34.0",
    "sonner": "^2.0.8",
    "streamdown": "^2.7.0",
    "tokenlens": "^1.3.1",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.6",
    "vaul": "^1.1.2",
    "ws": "^8.22.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@lobehub/icons-static-svg": "^1.95.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plugin-electron": "1.1.2",
    "vite-plugin-singlefile": "^2.3.3",
    "vite-plus": "catalog:"
  },
  "build": {
    "appId": "dev.mochi.app",
    "productName": "Mochi",
    "files": [
      "dist/**",
      "dist-electron/**",
      "!node_modules/**",
      "node_modules/node-pty/package.json",
      "node_modules/node-pty/lib/*.js",
      "node_modules/node-pty/prebuilds/${platform}-${arch}/**"
    ],
    "afterPack": "scripts/after-pack.mjs",
    "asarUnpack": [
      "node_modules/node-pty/prebuilds/**"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": "dir",
      "icon": "build/icon.icns",
      "identity": null,
      "extraResources": [
        {
          "from": "build/native/haptic",
          "to": "haptic"
        },
        {
          "from": "build/native/windows",
          "to": "windows"
        }
      ]
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "extraResources": [
        {
          "from": "build/icon.png",
          "to": "icon.png"
        }
      ]
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png",
      "category": "Development",
      "extraResources": [
        {
          "from": "build/icon.png",
          "to": "icon.png"
        }
      ]
    }
  }
}
