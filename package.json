{
  "name": "harness-proto",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b && tsc -p electron",
    "test": "node --test 'src/**/*.test.ts'",
    "artifact": "pnpm build && node scripts/artifact.mjs",
    "electron:dev": "vite --mode electron",
    "electron:build": "tsc -b && tsc -p electron && vite build --mode electron && electron-builder --mac --dir"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@fontsource-variable/inter": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@pierre/diffs": "^1.5.2",
    "@radix-ui/react-use-controllable-state": "^1.2.6",
    "@react-symbols/icons": "^1.4.1",
    "@shadcn/react": "^0.3.1",
    "@streamdown/cjk": "^1.0.4",
    "@streamdown/code": "^2.0.0",
    "@streamdown/math": "^1.0.3",
    "@streamdown/mermaid": "^1.0.3",
    "ai": "^7.0.137",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "codemirror": "^6.0.2",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "motion": "^14.1.0",
    "nanoid": "^6.0.2",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.0",
    "react-resizable-panels": "^4.14.4",
    "recharts": "3.8.0",
    "reicon-react": "^1.2.6",
    "shadcn": "^4.21.4",
    "shiki": "^4.5.0",
    "simple-icons": "^16.34.0",
    "sonner": "^2.0.8",
    "streamdown": "^2.7.0",
    "tokenlens": "^1.3.1",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.6",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@lobehub/icons-static-svg": "^1.95.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-electron": "1.1.2",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "build": {
    "appId": "dev.harness.app",
    "productName": "Harness",
    "files": [
      "dist/**",
      "dist-electron/**",
      "!node_modules/**"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": "dir",
      "identity": null
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ]
  }
}
